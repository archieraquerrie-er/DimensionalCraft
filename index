            <section id="tab-ai" class="bg-white rounded-2xl p-6 shadow-sm border border-slate-200 space-y-4 hidden flex flex-col h-[560px]">
                <div class="border-b pb-3 flex justify-between items-center">
                    <div>
                        <span class="bg-purple-50 text-purple-700 text-xs font-semibold px-3 py-1 rounded-full"><i class="fa-solid fa-robot mr-1"></i> Asisten AI Cerdas (Diperbarui dengan Literatur Internet & Repositori)</span>
                        <h2 class="text-lg font-bold text-slate-900 mt-1">Tanya Jawab Pintar Konsep & Sumber Rujukan Luas</h2>
                    </div>
                    <button onclick="clearChat()" class="text-xs text-slate-400 hover:text-slate-600"><i class="fa-solid fa-rotate-right mr-1"></i> Reset</button>
                </div>

                <!-- Chat Stream Box -->
                <div id="chat-container" class="flex-grow overflow-y-auto space-y-3 pr-2 text-sm">
                    <div class="flex items-start space-x-2">
                        <div class="bg-indigo-600 text-white w-7 h-7 rounded-full flex items-center justify-center text-xs shrink-0"><i class="fa-solid fa-robot"></i></div>
                        <div class="bg-slate-100 text-slate-800 p-3 rounded-2xl rounded-tl-none max-w-[85%] text-xs leading-relaxed">
                            Halo! AI Assistant kini telah di-update dengan basis literatur internet tambahan (seperti Khan Academy, Zenius/Clearnote archive, GeoGebra Classroom, dan Jurnal Pendidikan Matematika). Silakan tanyakan materi, rumus, atau minta rekomendasi sumber online!
                        </div>
                    </div>
                </div>

                <!-- Chat Input Form -->
                <form id="chat-form" onsubmit="handleChatSubmit(event)" class="flex gap-2 pt-2 border-t">
                    <input type="text" id="chat-input" placeholder="Tanyakan materi atau minta referensi internet (misal: referensi web tentang jarak titik ke garis)..." class="flex-grow border rounded-xl px-4 py-2 text-xs focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <button type="submit" class="bg-indigo-600 hover:bg-indigo-700 text-white px-4 py-2 rounded-xl text-xs font-medium transition"><i class="fa-solid fa-paper-plane"></i></button>
                </form>
            </section>

        </div>

        <!-- Right Sidebar: Student Info & Quick Tips -->
        <div class="space-y-6">
            <!-- Student Profile Box -->
            <div class="bg-white rounded-2xl p-5 shadow-sm border border-slate-200 space-y-4">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 font-bold">
                        <i class="fa-solid fa-user-graduate"></i>
                    </div>
                    <div>
                        <h3 class="font-bold text-slate-800 text-sm">Siswa Kelas XII SMA</h3>
                        <p class="text-xs text-slate-500">Fase F • Kurikulum Merdeka</p>
                    </div>
                </div>
                <div class="pt-3 border-t grid grid-cols-2 gap-2 text-center">
                    <div class="bg-slate-50 p-2.5 rounded-xl border">
                        <p class="text-[10px] text-slate-400 uppercase font-semibold">Status Modul</p>
                        <p class="text-xs font-bold text-indigo-600 mt-0.5">Komprehensif</p>
                    </div>
                    <div class="bg-slate-50 p-2.5 rounded-xl border">
                        <p class="text-[10px] text-slate-400 uppercase font-semibold">Media Utama</p>
                        <p class="text-xs font-bold text-emerald-600 mt-0.5">3D & GeoGebra</p>
                    </div>
                </div>
            </div>

            <!-- Quick Tips Scaffolding -->
            <div class="bg-gradient-to-br from-indigo-900 to-slate-900 text-white rounded-2xl p-5 shadow-sm space-y-3">
                <div class="flex items-center space-x-2 text-indigo-300">
                    <i class="fa-solid fa-compass text-sm"></i>
                    <h3 class="font-bold text-sm">Pusat Belajar Mandiri</h3>
                </div>
                <p class="text-xs text-slate-300 leading-relaxed">
                    Modul ini memuat materi rinci, rujukan repositori Kemendikdasmen, serta panduan proyek arsitektur GeoGebra. Gunakan Asisten AI jika menemui kesulitan perhitungan!
                </p>
            </div>
        </div>

    </main>

    <script>
        function switchTab(tabId) {
            const tabs = ['materi', 'visualizer', 'referensi', 'proyek', 'ai'];
            tabs.forEach(t => {
                const sec = document.getElementById('tab-' + t);
                if(sec) sec.classList.add('hidden');
                const navBtn = document.getElementById('nav-' + t);
                if(navBtn) {
                    navBtn.className = 'text-indigo-200 hover:text-white pb-1 transition';
                }
            });
            const activeSec = document.getElementById('tab-' + tabId);
            if(activeSec) activeSec.classList.remove('hidden');
            const activeNav = document.getElementById('nav-' + tabId);
            if(activeNav) {
                activeNav.className = 'text-white border-b-2 border-white pb-1 transition';
            }
            if(tabId === 'visualizer' && !rendererInitialized) {
                initThreeJS();
            }
            if(window.MathJax) {
                window.MathJax.typesetPromise();
            }
        }

        let scene, camera, renderer, currentMesh, rendererInitialized = false;
        let isDragging = false;
        let vertexSprites = [];

        function initThreeJS() {
            const container = document.getElementById('canvas-box');
            if(!container) return;
            container.innerHTML = '';

            scene = new THREE.Scene();
            camera = new THREE.PerspectiveCamera(45, container.clientWidth / container.clientHeight, 0.1, 1000);
            camera.position.set(4, 3, 5);
            camera.lookAt(0, 0, 0);

            renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
            renderer.setSize(container.clientWidth, container.clientHeight);
            renderer.setClearColor(0x0f172a);
            container.appendChild(renderer.domElement);

            const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
            scene.add(ambientLight);
            const pointLight = new THREE.PointLight(0xffffff, 1.2);
            pointLight.position.set(5, 5, 5);
            scene.add(pointLight);

            createShape('cube');

            let prevMousePos = { x: 0, y: 0 };

            container.addEventListener('mousedown', (e) => { isDragging = true; prevMousePos = { x: e.clientX, y: e.clientY }; });
            window.addEventListener('mouseup', () => { isDragging = false; });
            container.addEventListener('mousemove', (e) => {
                if (!isDragging || !currentMesh) return;
                const deltaX = e.clientX - prevMousePos.x;
                const deltaY = e.clientY - prevMousePos.y;
                currentMesh.rotation.y += deltaX * 0.01;
                currentMesh.rotation.x += deltaY * 0.01;
                prevMousePos = { x: e.clientX, y: e.clientY };
            });

            container.addEventListener('touchstart', (e) => {
                if(e.touches.length === 1) {
                    isDragging = true;
                    prevMousePos = { x: e.touches[0].clientX, y: e.touches[0].clientY };
                }
            });
            window.addEventListener('touchend', () => { isDragging = false; });
            container.addEventListener('touchmove', (e) => {
                if(!isDragging || !currentMesh || e.touches.length !== 1) return;
                const deltaX = e.touches[0].clientX - prevMousePos.x;
                const deltaY = e.touches[0].clientY - prevMousePos.y;
                currentMesh.rotation.y += deltaX * 0.01;
                currentMesh.rotation.x += deltaY * 0.01;
                prevMousePos = { x: e.touches[0].clientX, y: e.touches[0].clientY };
            });

            rendererInitialized = true;
            animate();
        }

        function createTextSprite(message) {
            const canvas = document.createElement('canvas');
            const context = canvas.getContext('2d');
            canvas.width = 128;
            canvas.height = 128;
            context.fillStyle = '#38bdf8';
            context.font = 'Bold 64px "Plus Jakarta Sans", sans-serif';
            context.textAlign = 'center';
            context.textBaseline = 'middle';
            context.fillText(message, 64, 64);

            const texture = new THREE.CanvasTexture(canvas);
            const spriteMaterial = new THREE.SpriteMaterial({ map: texture, transparent: true });
            const sprite = new THREE.Sprite(spriteMaterial);
            sprite.scale.set(0.4, 0.4, 0.4);
            return sprite;
        }

        function createShape(type) {
            if(currentMesh) scene.remove(currentMesh);
            vertexSprites.forEach(s => scene.remove(s));
            vertexSprites = [];

            const group = new THREE.Group();

            if(type === 'limas') {
                const hw = 1.2;
                const hh = 1.4;
                const peak = new THREE.Vector3(0, hh, 0);
                const A = new THREE.Vector3(-hw, -hh, hw);
                const B = new THREE.Vector3(hw, -hh, hw);
                const C = new THREE.Vector3(hw, -hh, -hw);
                const D = new THREE.Vector3(-hw, -hh, -hw);

                const pyrGeo = new THREE.BufferGeometry();
                const vertices = new Float32Array([
                    A.x, A.y, A.z,  B.x, B.y, B.z,  C.x, C.y, C.z,
                    A.x, A.y, A.z,  C.x, C.y, C.z,  D.x, D.y, D.z,
                    peak.x, peak.y, peak.z,  A.x, A.y, A.z,  B.x, B.y, B.z,
                    peak.x, peak.y, peak.z,  B.x, B.y, B.z,  C.x, C.y, C.z,
                    peak.x, peak.y, peak.z,  C.x, C.y, C.z,  D.x, D.y, D.z,
                    peak.x, peak.y, peak.z,  D.x, D.y, D.z,  A.x, A.y, A.z
                ]);
                pyrGeo.setAttribute('position', new THREE.BufferAttribute(vertices, 3));
                pyrGeo.computeVertexNormals();

                const material = new THREE.MeshStandardMaterial({ 
                    color: 0x818cf8, 
                    roughness: 0.2, 
                    metalness: 0.1,
                    transparent: true,
                    opacity: 0.28,
                    side: THREE.DoubleSide
                });
                
                const mesh = new THREE.Mesh(pyrGeo, material);
                group.add(mesh);

                const wireframeGeo = new THREE.WireframeGeometry(pyrGeo);
                const wireframeMat = new THREE.LineBasicMaterial({ color: 0x93c5fd, linewidth: 2 });
                const wireframe = new THREE.LineSegments(wireframeGeo, wireframeMat);
                group.add(wireframe);

                const vertexPositions = {
                    'T': new THREE.Vector3(0, hh + 0.3, 0),
                    'A': new THREE.Vector3(-hw - 0.2, -hh - 0.2, hw + 0.2),
                    'B': new THREE.Vector3(hw + 0.2, -hh - 0.2, hw + 0.2),
                    'C': new THREE.Vector3(hw + 0.2, -hh - 0.2, -hw - 0.2),
                    'D': new THREE.Vector3(-hw - 0.2, -hh - 0.2, -hw - 0.2)
                };

                for(let key in vertexPositions) {
                    const sprite = createTextSprite(key);
                    sprite.position.copy(vertexPositions[key]);
                    group.add(sprite);
                    vertexSprites.push(sprite);
                }

            } else {
                let width = 2, height = 2, depth = 2;
                if(type === 'balok') {
                    width = 2.6; height = 1.6; depth = 2.2;
                }

                const geometry = new THREE.BoxGeometry(width, height, depth);
                const material = new THREE.MeshStandardMaterial({ 
                    color: 0x6366f1, 
                    roughness: 0.2, 
                    metalness: 0.1,
                    transparent: true,
                    opacity: 0.25,
                    side: THREE.DoubleSide
                });
                
                const wireframeGeo = new THREE.WireframeGeometry(geometry);
                const wireframeMat = new THREE.LineBasicMaterial({ color: 0x93c5fd, linewidth: 2 });
                const wireframe = new THREE.LineSegments(wireframeGeo, wireframeMat);

                const mesh = new THREE.Mesh(geometry, material);
                mesh.add(wireframe);
                group.add(mesh);

                const hw = width / 2;
                const hh = height / 2;
                const hd = depth / 2;

                const vertexPositions = {
                    'A': new THREE.Vector3(-hw - 0.2, -hh - 0.2, hd + 0.2),
                    'B': new THREE.Vector3(hw + 0.2, -hh - 0.2, hd + 0.2),
                    'C': new THREE.Vector3(hw + 0.2, -hh - 0.2, -hd - 0.2),
                    'D': new THREE.Vector3(-hw - 0.2, -hh - 0.2, -hd - 0.2),
                    'E': new THREE.Vector3(-hw - 0.2, hh + 0.2, hd + 0.2),
                    'F': new THREE.Vector3(hw + 0.2, hh + 0.2, hd + 0.2),
                    'G': new THREE.Vector3(hw + 0.2, hh + 0.2, -hd - 0.2),
                    'H': new THREE.Vector3(-hw - 0.2, hh + 0.2, -hd - 0.2)
                };

                for(let key in vertexPositions) {
                    const sprite = createTextSprite(key);
                    sprite.position.copy(vertexPositions[key]);
                    group.add(sprite);
                    vertexSprites.push(sprite);
                }
            }

            currentMesh = group;
            scene.add(currentMesh);
        }

        function setShape(type) {
            createShape(type);
            ['cube', 'balok', 'limas'].forEach(t => {
                const btn = document.getElementById('btn-' + t);
                if(btn) {
                    if(t === type) {
                        btn.className = 'px-3 py-1.5 text-xs font-semibold rounded-lg bg-indigo-600 text-white transition';
                    } else {
                        btn.className = 'px-3 py-1.5 text-xs font-semibold rounded-lg bg-slate-100 text-slate-600 hover:bg-slate-200 transition';
                    }
                }
            });
        }

        function animate() {
            requestAnimationFrame(animate);
            if(currentMesh && !isDragging) {
                currentMesh.rotation.y += 0.004;
            }
            if(renderer && scene && camera) {
                renderer.render(scene, camera);
            }
        }

        function handleChatSubmit(e) {
            e.preventDefault();
            const input = document.getElementById('chat-input');
            const text = input.value.trim();
            if(!text) return;

            const container = document.getElementById('chat-container');
            
            container.innerHTML += `
                <div class="flex items-start justify-end space-x-2">
                    <div class="bg-indigo-600 text-white p-3 rounded-2xl rounded-tr-none max-w-[85%] text-xs leading-relaxed">
                        ${escapeHtml(text)}
                    </div>
                </div>
            `;
            input.value = '';
            container.scrollTop = container.scrollHeight;

            setTimeout(() => {
                let reply = "Berdasarkan Repositori Modul Kemendikdasmen dan literatur E-Modul, untuk menyelesaikan soal dimensi tiga, pastikan Anda menuliskan unsur yang diketahui, membuat sketsa segitiga siku-siku penolong, lalu menerapkan Teorema Pythagoras secara sistematis.";
                let source = "Sumber: Repositori Kemendikdasmen (Modul KD 3.1)";
                const lower = text.toLowerCase();
                
                if(lower.includes('garis') || lower.includes('jarak titik ke garis')) {
                    reply = "Jarak titik ke garis adalah panjang ruas garis terpendek yang tegak lurus dari titik ke garis tersebut. Langkah analitisnya: (1) Hubungkan titik ke dua ujung garis membentuk segitiga, (2) Hitung sisi segitiga dengan Pythagoras, (3) Gunakan rumus luas segitiga (\\(\\frac{1}{2} \\times \\text{alas} \\times \\text{tinggi}\\)) untuk mencari jarak tegak lurus.";
                    source = "Sumber: Repositori Kemendikdasmen KD 3.1 & EDUPEDIA (Haqq & Handoko, 2023)";
                } else if(lower.includes('diagonal') || lower.includes('rusuk') || lower.includes('s\\sqrt')) {
                    reply = "Pada kubus dengan panjang rusuk \\(s\\): diagonal sisi bernilai \\(s\\sqrt{2}\\) dan diagonal ruang bernilai \\(s\\sqrt{3}\\). Nilai ini diperoleh langsung dari penjabaran Teorema Pythagoras pada bidang diagonal kubus.";
                    source = "Sumber: Modul Matematika Umum Kelas XII Kemendikdasmen";
                } else if(lower.includes('proyek') || lower.includes('geogebra') || lower.includes('tugas') || lower.includes('kelompok') || lower.includes('analisis')) {
                    reply = "Ketentuan proyek mewajibkan kelompok Anda: (1) Membuat desain gabungan minimal 2 bangun ruang secara estetis di GeoGebra, (2) Melakukan 3 analisis wajib: Jarak titik ke titik, Jarak titik ke garis (dengan segitiga penolong), dan Jarak titik ke diagonal sisi/ruang.";
                    source = "Sumber: Lembar Ketentuan Proyek Kelompok PjBL";
                } else if(lower.includes('internet') || lower.includes('referensi web') || lower.includes('sumber online') || lower.includes('tautan')) {
                    reply = "Berikut tambahan referensi internet populer untuk eksplorasi dimensi tiga:\n1. **Khan Academy (Geometry 3D)**: Penjelasan konsep ruang interaktif berbahasa Inggris.\n2. **GeoGebra Materials (geogebra.org/m/geometry)**: Ribuan simulasi kubus dan balok buatan guru sedunia.\n3. **Zenius / Clearnote Archive**: Catatan ringkas rumus cepat sudut dan jarak dalam ruang SMA.\n4. **Kanal YouTube Privat Al Faiz**: Video bedah soal UTBK/SNBT dimensi tiga.";
                    source = "Sumber: Jaringan Literatur Digital & Portal Pendidikan Global";
                } else if(lower.includes('buku') || lower.includes('referensi') || lower.includes('sumber') || lower.includes('pdf')) {
                    reply = "Anda dapat mengakses modul resmi melalui tautan PDF Repositori Kemendikdasmen di tab Referensi, atau membaca buku pegangan Kurikulum Merdeka Matematika Kelas XII Fase F.";
                    source = "Sumber: Daftar Pustaka & Repositori Kemendikdasmen RI";
                } else if(lower.includes('balok') || lower.includes('panjang') || lower.includes('lebar') || lower.includes('tinggi')) {
                    reply = "Pada balok dengan ukuran panjang \\(p\\), lebar \\(l\\), dan tinggi \\(t\\), panjang diagonal ruang dihitung dengan rumus \\(\\sqrt{p^2 + l^2 + t^2}\\).";
                    source = "Sumber: Ringkasan Rumus Geometri Ruang";
                } else if(lower.includes('bidang') || lower.includes('titik ke bidang')) {
                    reply = "Jarak titik ke bidang ditentukan dengan menarik garis dari titik tersebut yang menembus tegak lurus pada bidang. Panjang ruas garis dari titik awal ke titik proyeksi pada bidang adalah nilai jarak yang dicari.";
                    source = "Sumber: Modul KD 3.1 Kemendikdasmen";
                }

                container.innerHTML += `
                    <div class="flex items-start space-x-2">
                        <div class="bg-indigo-600 text-white w-7 h-7 rounded-full flex items-center justify-center text-xs shrink-0"><i class="fa-solid fa-robot"></i></div>
                        <div class="bg-slate-100 text-slate-800 p-3 rounded-2xl rounded-tl-none max-w-[85%] text-xs leading-relaxed space-y-2 whitespace-pre-line">
                            <p>${reply}</p>
                            <span class="inline-block bg-indigo-50 text-indigo-700 text-[10px] font-semibold px-2 py-0.5 rounded border border-indigo-100">${source}</span>
                        </div>
                    </div>
                `;
                container.scrollTop = container.scrollHeight;
                if(window.MathJax) {
                    window.MathJax.typesetPromise();
                }
            }, 700);
        }

        function clearChat() {
            document.getElementById('chat-container').innerHTML = `
                <div class="flex items-start space-x-2">
                    <div class="bg-indigo-600 text-white w-7 h-7 rounded-full flex items-center justify-center text-xs shrink-0"><i class="fa-solid fa-robot"></i></div>
                    <div class="bg-slate-100 text-slate-800 p-3 rounded-2xl rounded-tl-none max-w-[85%] text-xs leading-relaxed">
                        Riwayat percakapan dibersihkan. Silakan tanyakan materi, rumus, atau referensi internet kapan saja!
                    </div>
                </div>
            `;
        }

        function escapeHtml(string) {
            return String(string).replace(/&/g, '&amp;').replace(/&lt;([a-z\/])/gi, '&lt;$1').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
    </script>
